{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Engine: gRPC server (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/engine/main.py",
            "cwd": "${workspaceFolder}/engine",
            "python": "${workspaceFolder}/.janusenv/Scripts/python.exe"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/engine",
            "env": { "PYTHONPATH": "${workspaceFolder}/engine" },
            "python": "${workspaceFolder}/.janusenv/Scripts/python.exe"
        },
        {
            "name": "Janus",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/janus",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Janus + Engine",
            "configurations": ["Engine: gRPC server (main.py)", "Janus"],
            "stopAll": true
        }
    ]
}
