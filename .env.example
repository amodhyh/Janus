# Pass 3: LLM judge (Ollama)
JANUS_OLLAMA_URL=http://localhost:11434
JANUS_JUDGE_MODEL=phi4-mini
JANUS_JUDGE_TIMEOUT=10

# Pass 4: decision log
# Defaults to <repo>/data/decisions.db when unset.
# JANUS_DECISION_DB=data/decisions.db
# Set to 1 to store raw prompts in the log (may contain secrets).
JANUS_LOG_PROMPTS=0

# Pass 2: SLM classifier
# Defaults to <repo>/models/piguard_onnx.
# JANUS_SLM_MODEL_DIR=models/piguard_onnx
JANUS_SLM_TOKEN_LIMIT=512
JANUS_SLM_DENY_PROB=0.95
JANUS_SLM_ALLOW_PROB=0.05

# Judge extras
JANUS_JUDGE_KEEP_ALIVE=30m
JANUS_JUDGE_MAX_CHARS=4000

# gRPC engine server
JANUS_ENGINE_LISTEN=[::]:50051
JANUS_ENGINE_WORKERS=10
JANUS_ENGINE_MAX_RPCS=20

# Go proxy (read from the process environment; the Go side does not load .env)
JANUS_ENGINE_ADDR=localhost:50051
JANUS_CONFIG=config/janus.yaml

# Provider secrets and per-environment values, referenced from config/janus.yaml
OPENAI_API_KEY=
GEMINI_API_KEY=
# JANUS_REDIS_ADDR=localhost:6379
